{
 "contract": "algal.organism.v1",
 "key": "organism:jury",
 "name": "Jury",
 "note": "The tournament: every pair of candidate subjects fights one judged duel, wins are tallied, the champion is the form that lost least. Piecemeal selection where the criterion is judged fit, not mechanical compliance \u2014 the two scorers can be compared honestly.",
 "budgets": {
  "maxSteps": 64,
  "maxAgentCalls": 16,
  "maxWork": 200000
 },
