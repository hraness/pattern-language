{
 "contract": "algal.organism.v1",
 "key": "organism:commit-subject-generator",
 "name": "Commit-subject generator",
 "note": "Variation inside a grammar: the agent emits format descriptors (lit|field parts over the change/hint vocabulary), the assembler stamps valid manifests. prior carries last generation's jury standings \u2014 mutation aims at judged fit, not novelty.",
 "budgets": {
  "maxSteps": 32,
  "maxAgentCalls": 4,
  "maxWork": 120000
 },
 "interface": {
  "inputs": {
   "task": {
    "cell": "src",
    "port": "task"
   },
   "prior": {
    "cell": "src",
    "port": "prior"
   }
  },
  "outputs": {
   "candidates": {
    "cell": "build",
    "port": "out"
   }
  }
 },
 "cells": [
  {
   "id": "src",
   "kind": "input",
   "outputs": {
    "task": "text",
    "prior": "json"
   }
  },
  {
   "id": "writer",
   "kind": "agent",
   "inputs": {
    "task": "text",
    "prior": "json"
   },
   "prompt": "Emit EXACTLY 4 distinct commit-subject format variants. Return ONLY {\"variants\": [{\"key\": \"kebab-name\", \"name\": \"display name\", \"parts\": [<part>, ...]}, ...]} where each part is {\"t\": \"lit\", \"v\": \"literal text\"} or {\"t\": \"field\", \"v\": \"verb|Verb|what|why|area|files|ins|del\"}. field Verb is the capitalized verb; area is the first change area; files/ins/del render as numbers. Input prior carries the last generation's jury standings: which formats won judged duels. Keep what won, mutate the champion once, and try one genuinely different hypothesis. The jury favors: leads with the act, honest scope, conveys WHY over bare WHAT, no noise, under 72 chars.",
   "output": {
    "kind": "json",
    "schema": {
     "type": "object",
     "required": [
      "variants"
     ],
     "properties": {
      "variants": {
       "type": "array"
      }
     }
    }
   },
   "view": {
    "inputs": [
     "task",
     "prior"
    ]
   },
   "budget": {
    "maxContextBytes": 8192,
    "maxOutputBytes": 16384
   },
   "retry": {
    "attempts": 2
   }
  },
  {
   "id": "build",
   "kind": "expr",
   "inputs": {
    "specs": "json"
   },
   "expr": {
    "contract": "algal.expr.v1",
    "program": [
     "let",
     "specs",
     [
      "get",
      "specs",
      "variants"
     ],
     [
      "map",
      [
       "get",
       "specs"
      ],
      "s",
      {
       "contract": "algal.organism.v1",
       "key": [
        "sconcat",
        "organism:",
        [
         "get",
         "s",
         "key"
        ]
       ],
       "name": [
        "get",
        "s",
        "name"
       ],
       "budgets": [
        "quote",
        {
         "maxSteps": 8,
         "maxAgentCalls": 0,
         "maxWork": 20000
        }
       ],
       "interface": [
        "quote",
        {
         "inputs": {
          "job": {
           "cell": "src",
           "port": "job"
          }
         },
         "outputs": {
          "subject": {
           "cell": "fmt",
           "port": "out"
          }
         }
        }
       ],
       "cells": [
        "list",
        [
         "quote",
         {
          "id": "src",
          "kind": "input",
          "outputs": {
           "job": "json"
          }
         }
        ],
        {
         "id": "fmt",
         "kind": "expr",
         "inputs": [
          "quote",
          {
           "job": "json"
          }
         ],
         "expr": {
          "contract": "algal.expr.v1",
          "program": [
           "concat",
           [
            "quote",
            [
             "sconcat"
            ]
           ],
           [
            "map",
            [
             "get",
             "s",
             "parts"
            ],
            "p",
            [
             "if",
             [
              "eq",
              [
               "get",
               "p",
               "t"
              ],
              "lit"
             ],
             [
              "get",
              "p",
              "v"
             ],
             [
              "if",
              [
               "eq",
               [
                "get",
                "p",
                "v"
               ],
               "area"
              ],
              [
               "list",
               "nth",
               [
                "list",
                "get",
                "job",
                "change",
                "areas"
               ],
               0
              ],
              [
               "if",
               [
                "contains",
                [
                 "quote",
                 [
                  "files",
                  "ins",
                  "del"
                 ]
                ],
                [
                 "get",
                 "p",
                 "v"
                ]
               ],
               [
                "list",
                "toText",
                [
                 "list",
                 "get",
                 "job",
                 "change",
                 [
                  "get",
                  "p",
                  "v"
                 ]
                ]
               ],
               [
                "list",
                "get",
                "job",
                "hint",
                [
                 "get",
                 "p",
                 "v"
                ]
               ]
              ]
             ]
            ]
           ]
          ]
         },
         "output": [
          "quote",
          {
           "kind": "text"
          }
         ]
        }
       ],
       "edges": [
        "quote",
        [
         {
          "from": {
           "cell": "src",
           "port": "job"
          },
          "to": {
           "cell": "fmt",
           "port": "job"
          }
         }
        ]
       ]
      }
     ]
    ]
   },
   "output": {
    "kind": "json",
    "schema": {
     "type": "array"
    }
   }
  }
 ],
 "edges": [
  {
   "from": {
    "cell": "src",
    "port": "task"
   },
   "to": {
    "cell": "writer",
    "port": "task"
   }
  },
  {
   "from": {
    "cell": "src",
    "port": "prior"
   },
   "to": {
    "cell": "writer",
    "port": "prior"
   }
  },
  {
   "from": {
    "cell": "writer",
    "port": "out"
   },
   "to": {
    "cell": "build",
    "port": "specs"
   }
  }
 ]
}
