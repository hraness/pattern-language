{
 "contract": "algal.organism.v1",
 "key": "organism:partition-village-generator",
 "name": "Partition-village generator",
 "note": "Variation over decompositions of Alexander's Appendix I village corpus: 141 requirements into 8-16 named subsystems; assembler quotes each into a valid organism.",
 "budgets": {
  "maxSteps": 32,
  "maxAgentCalls": 4,
  "maxWork": 120000
 },
 "interface": {
  "inputs": {
   "task": {
    "cell": "src",
    "port": "task"
   },
   "prior": {
    "cell": "src",
    "port": "prior"
   },
   "job": {
    "cell": "src",
    "port": "job"
   },
   "repair-program": {
    "cell": "src",
    "port": "repair-program"
   }
  },
  "outputs": {
   "candidates": {
    "cell": "build",
    "port": "out"
   }
  }
 },
 "cells": [
  {
   "id": "src",
   "kind": "input",
   "outputs": {
    "task": "json",
    "prior": "json",
    "job": "json",
    "repair-program": "json"
   }
  },
  {
   "id": "writer",
   "kind": "agent",
   "inputs": {
    "task": "json",
    "prior": "json",
    "job": "json"
   },
   "prompt": "Emit EXACTLY 3 distinct decompositions of the 141 village requirements in job.misfits into 8-16 named subsystems. Return ONLY {\"variants\": [{\"key\": \"kebab-name\", \"name\": \"display\", \"groups\": [{\"name\": \"subsystem-name\", \"misfits\": [\"m1\", ...]}, ...]}, ...]}. Every misfit id must appear in exactly one group; each group needs >= 2 members and a name that captures the shared force (e.g. caste, water, housing, economy). job.links lists requirement couplings \u2014 keep coupled requirements together and minimize cross-group edges. Input prior carries jury standings and prior.mechanical (constraint terms violators failed \u2014 repair the misfit, keep the winning shape). Judges favor coherent groups whose names explain why the members belong together. Exact coverage is completed mechanically downstream \u2014 prioritize coherent force structure and names over bookkeeping.",
   "output": {
    "kind": "json",
    "schema": {
     "type": "object",
     "required": [
      "variants"
     ]
    }
   },
   "budget": {
    "maxEffectMs": 600000,
    "maxTurns": 1,
    "maxContextBytes": 262144
   }
  },
  {
   "id": "build",
   "kind": "expr",
   "inputs": {
    "specs": "json",
    "repair-program": "json"
   },
   "expr": {
    "contract": "algal.expr.v1",
    "program": [
     "map",
     [
      "get",
      "specs",
      "variants"
     ],
     "v",
     {
      "contract": "algal.organism.v1",
      "key": [
       "sconcat",
       "organism:",
       [
        "get",
        "v",
        "key"
       ]
      ],
      "name": [
       "get",
       "v",
       "name"
      ],
      "budgets": {
       "maxSteps": 8,
       "maxAgentCalls": 0,
       "maxWork": 150000
      },
      "interface": {
       "inputs": {
        "job": {
         "cell": "src",
         "port": "job"
        }
       },
       "outputs": {
        "message": {
         "cell": "fmt",
         "port": "out"
        }
       }
      },
      "cells": [
       "list",
       {
        "id": "src",
        "kind": "input",
        "outputs": {
         "job": "json"
        }
       },
       {
        "id": "raw",
        "kind": "expr",
        "expr": {
         "contract": "algal.expr.v1",
         "program": [
          "list",
          "quote",
          [
           "get",
           "v",
           "groups"
          ]
         ]
        },
        "output": {
         "kind": "json",
         "schema": {
          "type": "array"
         }
        }
       },
       {
        "id": "fmt",
        "kind": "expr",
        "inputs": {
         "groups": "json",
         "job": "json"
        },
        "expr": {
         "contract": "algal.expr.v1",
         "program": [
          "get",
          "repair-program"
         ]
        },
        "output": {
         "kind": "json",
         "schema": {
          "type": "object"
         }
        }
       }
      ],
      "edges": [
       "list",
       {
        "from": {
         "cell": "src",
         "port": "job"
        },
        "to": {
         "cell": "fmt",
         "port": "job"
        }
       },
       {
        "from": {
         "cell": "raw",
         "port": "out"
        },
        "to": {
         "cell": "fmt",
         "port": "groups"
        }
       }
      ]
     }
    ]
   },
   "output": {
    "kind": "json",
    "schema": {
     "type": "array"
    }
   }
  }
 ],
 "edges": [
  {
   "from": {
    "cell": "src",
    "port": "task"
   },
   "to": {
    "cell": "writer",
    "port": "task"
   }
  },
  {
   "from": {
    "cell": "src",
    "port": "prior"
   },
   "to": {
    "cell": "writer",
    "port": "prior"
   }
  },
  {
   "from": {
    "cell": "src",
    "port": "job"
   },
   "to": {
    "cell": "writer",
    "port": "job"
   }
  },
  {
   "from": {
    "cell": "writer",
    "port": "out"
   },
   "to": {
    "cell": "build",
    "port": "specs"
   }
  },
  {
   "from": {
    "cell": "src",
    "port": "repair-program"
   },
   "to": {
    "cell": "build",
    "port": "repair-program"
   }
  }
 ]
}
