{
 "contract": "algal.organism.v1",
 "key": "organism:metric-first",
 "name": "Metric first",
 "note": "The number leads; the claim follows.",
 "budgets": {
  "maxSteps": 8,
  "maxAgentCalls": 0,
  "maxWork": 20000
 },
 "interface": {
  "inputs": {
   "rec": {
    "cell": "src",
    "port": "rec"
   }
  },
  "outputs": {
   "line": {
    "cell": "fmt",
    "port": "out"
   }
  }
 },
 "cells": [
  {
   "id": "src",
   "kind": "input",
   "outputs": {
    "rec": "json"
   }
  },
  {
   "id": "fmt",
   "kind": "expr",
   "inputs": {
    "rec": "json"
   },
   "expr": {
    "contract": "algal.expr.v1",
    "program": [
     "sconcat",
     [
      "get",
      "rec",
      "metric"
     ],
     " | ",
     [
      "get",
      "rec",
      "tool"
     ],
     " ",
     [
      "get",
      "rec",
      "target"
     ],
     " ",
     [
      "upper",
      [
       "get",
       "rec",
       "verdict"
      ]
     ]
    ]
   },
   "output": {
    "kind": "text"
   }
  }
 ],
 "edges": [
  {
   "from": {
    "cell": "src",
    "port": "rec"
   },
   "to": {
    "cell": "fmt",
    "port": "rec"
   }
  }
 ]
}
