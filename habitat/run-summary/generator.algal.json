{
 "contract": "algal.organism.v1",
 "key": "organism:run-summary-generator",
 "name": "Run-summary generator",
 "note": "Variation inside a grammar: descriptors over the record vocabulary (lit|tool|target|verdict|Verdict|metric), assembler stamps valid manifests. prior carries jury standings.",
 "budgets": {
  "maxSteps": 32,
  "maxAgentCalls": 4,
  "maxWork": 120000
 },
 "interface": {
  "inputs": {
   "task": {
    "cell": "src",
    "port": "task"
   },
   "prior": {
    "cell": "src",
    "port": "prior"
   }
  },
  "outputs": {
   "candidates": {
    "cell": "build",
    "port": "out"
   }
  }
 },
 "cells": [
  {
   "id": "src",
   "kind": "input",
   "outputs": {
    "task": "text",
    "prior": "json"
   }
  },
  {
   "id": "writer",
   "kind": "agent",
   "inputs": {
    "task": "text",
    "prior": "json"
   },
   "prompt": "Emit EXACTLY 4 distinct one-line run-summary format variants. Return ONLY {\"variants\": [{\"key\": \"kebab-name\", \"name\": \"display name\", \"parts\": [<part>, ...]}, ...]} where each part is {\"t\": \"lit\", \"v\": \"literal text\"} or {\"t\": \"field\", \"v\": \"tool|target|verdict|Verdict|metric\"}. field Verdict renders the verdict uppercased. Input prior carries last generation's jury standings (which formats won judged duels and which were contested). Keep what won, mutate the champion once, try one genuinely different hypothesis. Judges favor: verdict or evidence visible early, terse enough to scan in a wall of output, under 80 chars, no noise.",
   "output": {
    "kind": "json",
    "schema": {
     "type": "object",
     "required": [
      "variants"
     ],
     "properties": {
      "variants": {
       "type": "array"
      }
     }
    }
   },
   "view": {
    "inputs": [
     "task",
     "prior"
    ]
   },
   "budget": {
    "maxContextBytes": 8192,
    "maxOutputBytes": 16384
   },
   "retry": {
    "attempts": 2
   }
  },
  {
   "id": "build",
   "kind": "expr",
   "inputs": {
    "specs": "json"
   },
   "expr": {
    "contract": "algal.expr.v1",
    "program": [
     "let",
     "specs",
     [
      "get",
      "specs",
      "variants"
     ],
     [
      "map",
      [
       "get",
       "specs"
      ],
      "s",
      {
       "contract": "algal.organism.v1",
       "key": [
        "sconcat",
        "organism:",
        [
         "get",
         "s",
         "key"
        ]
       ],
       "name": [
        "get",
        "s",
        "name"
       ],
       "budgets": [
        "quote",
        {
         "maxSteps": 8,
         "maxAgentCalls": 0,
         "maxWork": 20000
        }
       ],
       "interface": [
        "quote",
        {
         "inputs": {
          "rec": {
           "cell": "src",
           "port": "rec"
          }
         },
         "outputs": {
          "line": {
           "cell": "fmt",
           "port": "out"
          }
         }
        }
       ],
       "cells": [
        "list",
        [
         "quote",
         {
          "id": "src",
          "kind": "input",
          "outputs": {
           "rec": "json"
          }
         }
        ],
        {
         "id": "fmt",
         "kind": "expr",
         "inputs": [
          "quote",
          {
           "rec": "json"
          }
         ],
         "expr": {
          "contract": "algal.expr.v1",
          "program": [
           "concat",
           [
            "quote",
            [
             "sconcat"
            ]
           ],
           [
            "map",
            [
             "get",
             "s",
             "parts"
            ],
            "p",
            [
             "if",
             [
              "eq",
              [
               "get",
               "p",
               "t"
              ],
              "lit"
             ],
             [
              "get",
              "p",
              "v"
             ],
             [
              "if",
              [
               "eq",
               [
                "get",
                "p",
                "v"
               ],
               "Verdict"
              ],
              [
               "list",
               "upper",
               [
                "list",
                "get",
                "rec",
                "verdict"
               ]
              ],
              [
               "list",
               "get",
               "rec",
               [
                "get",
                "p",
                "v"
               ]
              ]
             ]
            ]
           ]
          ]
         },
         "output": [
          "quote",
          {
           "kind": "text"
          }
         ]
        }
       ],
       "edges": [
        "quote",
        [
         {
          "from": {
           "cell": "src",
           "port": "rec"
          },
          "to": {
           "cell": "fmt",
           "port": "rec"
          }
         }
        ]
       ]
      }
     ]
    ]
   },
   "output": {
    "kind": "json",
    "schema": {
     "type": "array"
    }
   }
  }
 ],
 "edges": [
  {
   "from": {
    "cell": "src",
    "port": "task"
   },
   "to": {
    "cell": "writer",
    "port": "task"
   }
  },
  {
   "from": {
    "cell": "src",
    "port": "prior"
   },
   "to": {
    "cell": "writer",
    "port": "prior"
   }
  },
  {
   "from": {
    "cell": "writer",
    "port": "out"
   },
   "to": {
    "cell": "build",
    "port": "specs"
   }
  }
 ]
}
