{
 "contract": "algal.organism.v1",
 "key": "organism:signal-stack",
 "name": "Signal stack",
 "note": "Visibility misfits over fidelity misfits \u2014 co-locates a separated pair (m1 with m6).",
 "budgets": {
  "maxSteps": 8,
  "maxAgentCalls": 0,
  "maxWork": 20000
 },
 "interface": {
  "inputs": {
   "job": {
    "cell": "src",
    "port": "job"
   }
  },
  "outputs": {
   "message": {
    "cell": "fmt",
    "port": "out"
   }
  }
 },
 "cells": [
  {
   "id": "src",
   "kind": "input",
   "outputs": {
    "job": "json"
   }
  },
  {
   "id": "fmt",
   "kind": "expr",
   "inputs": {
    "job": "json"
   },
   "expr": {
    "contract": "algal.expr.v1",
    "program": [
     "quote",
     {
      "groups": [
       {
        "name": "visibility",
        "misfits": [
         "m1",
         "m5",
         "m3",
         "m6"
        ]
       },
       {
        "name": "fidelity",
        "misfits": [
         "m2",
         "m8",
         "m4",
         "m7"
        ]
       }
      ]
     }
    ]
   },
   "output": {
    "kind": "json",
    "schema": {
     "type": "object"
    }
   }
  }
 ],
 "edges": [
  {
   "from": {
    "cell": "src",
    "port": "job"
   },
   "to": {
    "cell": "fmt",
    "port": "job"
   }
  }
 ]
}
