{
 "contract": "algal.organism.v1",
 "key": "organism:status-line-generator",
 "name": "Status-line candidate generator",
 "note": "The habitat's variation engine — bounded generation: the agent emits format descriptors (literal/field parts), and a pure-expr assembler stamps them into guaranteed-valid manifests. Variation happens inside a grammar; population admission cannot fail on syntax — only the scorer judges semantics. Alexander's 'free combination' with the language constraining what's expressible.",
 "budgets": {
  "maxSteps": 8,
  "maxAgentCalls": 2,
  "maxWork": 100000
 },
 "interface": {
  "inputs": {
   "task": {
    "cell": "src",
    "port": "task"
   },
   "prior": {
    "cell": "src",
    "port": "prior"
   }
  },
  "outputs": {
   "candidates": {
    "cell": "build",
    "port": "out"
   }
  }
 },
 "cells": [
  {
   "id": "src",
   "kind": "input",
   "outputs": {
    "task": "text",
    "prior": "json"
   }
  },
  {
   "id": "writer",
   "kind": "agent",
   "inputs": {
    "task": "text",
    "prior": "json"
   },
   "prompt": "Emit EXACTLY 4 distinct status-line format variants for the task. Return ONLY {\"variants\": [{\"key\": \"kebab-name\", \"name\": \"display name\", \"parts\": [<part>, ...]}, ...]} where each part is one of: {\"t\": \"lit\", \"v\": \"literal text\"}, {\"t\": \"field\", \"v\": \"id|status|executor|detail\"}, or {\"t\": \"verdict\"} — the FIT/MISFIT token derived from status. Input prior carries last generation's outcome: the promoted digest and each candidate's train/validation pass counts. Keep what scored, repair what failed, and try at least one mutation of the champion. Forces the scorer checks: the verdict token leads the line; the line is at most 72 chars; the job id appears; the executor appears (provenance); no ANSI escapes. Each variant is a hypothesis about how to resolve those forces — vary field order, separators, verbosity.",
   "output": {
    "kind": "json",
    "schema": {
     "type": "object",
     "required": [
      "variants"
     ],
     "properties": {
      "variants": {
       "type": "array"
      }
     }
    }
   },
   "view": {
    "inputs": [
     "task",
     "prior"
    ]
   },
   "budget": {
    "maxContextBytes": 8192,
    "maxOutputBytes": 16384
   },
   "retry": {
    "attempts": 2
   }
  },
  {
   "id": "build",
   "kind": "expr",
   "inputs": {
    "specs": "json"
   },
   "expr": {
    "contract": "algal.expr.v1",
    "program": [
     "let",
     "specs",
     [
      "get",
      "specs",
      "variants"
     ],
     [
      "map",
      [
       "get",
       "specs"
      ],
      "s",
      {
       "contract": "algal.organism.v1",
       "key": [
        "sconcat",
        "organism:",
        [
         "get",
         "s",
         "key"
        ]
       ],
       "name": [
        "get",
        "s",
        "name"
       ],
       "budgets": [
        "quote",
        {
         "maxSteps": 8,
         "maxAgentCalls": 0,
         "maxWork": 20000
        }
       ],
       "interface": [
        "quote",
        {
         "inputs": {
          "job": {
           "cell": "src",
           "port": "job"
          }
         },
         "outputs": {
          "line": {
           "cell": "line",
           "port": "out"
          }
         }
        }
       ],
       "cells": [
        "list",
        {
         "id": "src",
         "kind": "input",
         "outputs": [
          "quote",
          {
           "job": "json"
          }
         ]
        },
        {
         "id": "line",
         "kind": "expr",
         "inputs": [
          "quote",
          {
           "job": "json"
          }
         ],
         "expr": {
          "contract": "algal.expr.v1",
          "program": [
           "concat",
           [
            "list",
            "sconcat"
           ],
           [
            "map",
            [
             "get",
             "s",
             "parts"
            ],
            "p",
            [
             "if",
             [
              "eq",
              [
               "get",
               "p",
               "t"
              ],
              "lit"
             ],
             [
              "get",
              "p",
              "v"
             ],
             [
              "if",
              [
               "eq",
               [
                "get",
                "p",
                "t"
               ],
               "verdict"
              ],
              [
               "list",
               "if",
               [
                "list",
                "eq",
                [
                 "list",
                 "get",
                 "job",
                 "status"
                ],
                "fit"
               ],
               "FIT",
               "MISFIT"
              ],
              [
               "list",
               "get",
               "job",
               [
                "get",
                "p",
                "v"
               ]
              ]
             ]
            ]
           ]
          ]
         },
         "output": [
          "quote",
          {
           "kind": "text"
          }
         ]
        }
       ],
       "edges": [
        "list",
        {
         "from": [
          "quote",
          {
           "cell": "src",
           "port": "job"
          }
         ],
         "to": [
          "quote",
          {
           "cell": "line",
           "port": "job"
          }
         ]
        }
       ]
      }
     ]
    ]
   },
   "output": {
    "kind": "json",
    "schema": {
     "type": "array"
    }
   }
  }
 ],
 "edges": [
  {
   "from": {
    "cell": "src",
    "port": "task"
   },
   "to": {
    "cell": "writer",
    "port": "task"
   }
  },
  {
   "from": {
    "cell": "src",
    "port": "prior"
   },
   "to": {
    "cell": "writer",
    "port": "prior"
   }
  },
  {
   "from": {
    "cell": "writer",
    "port": "out"
   },
   "to": {
    "cell": "build",
    "port": "specs"
   }
  }
 ]
}
