{
  "contract": "algal.organism.v1",
  "key": "organism:synthesize",
  "name": "Synthesize the form",
  "note": "The whole method as one organism: enumerate the ensemble, correlate the interaction graph, decompose into subsystems, construct a spawned diagram per subsystem, realize the fused form. Every stage is a digest-embedded organism cell \u2014 Alexander's 'program' as a DAG of content-addressed parts, and every intermediate (ensemble, links, subsystems, child digests) is an output you can inspect, not a hidden chain of thought.",
  "budgets": {
    "maxSteps": 256,
    "maxAgentCalls": 32,
    "maxWork": 800000
  },
  "interface": {
    "inputs": {
      "context": {
        "cell": "ctx",
        "port": "context"
      },
      "k": {
        "cell": "ctx",
        "port": "k"
      }
    },
    "outputs": {
      "ensemble": {
        "cell": "en",
        "port": "ensemble"
      },
      "links": {
        "cell": "co",
        "port": "links"
      },
      "subsystems": {
        "cell": "dc",
        "port": "subsystems"
      },
      "children": {
        "cell": "dg",
        "port": "child"
      },
      "misfits": {
        "cell": "dg",
        "port": "misfit"
      },
      "form": {
        "cell": "rz",
        "port": "fused"
      }
    }
  },
  "cells": [
