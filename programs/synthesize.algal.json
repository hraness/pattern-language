    },
    {
      "id": "pm",
      "kind": "expr",
      "inputs": {
        "e": "json"
      },
      "expr": {
        "contract": "algal.expr.v1",
        "program": [
          "get",
          "e",
          "misfits"
        ]
      },
      "output": {
        "kind": "json",
        "schema": {
          "type": "array"
        }
      }
    },
    {
      "id": "co",
      "kind": "organism",
      "manifest": "sha256:e8b696500e57cc47eb9cdb01ddd18fd5ff29a1fa9030844430857d9c2804bf7c"
    },
    {
      "id": "dc",
      "kind": "organism",
      "manifest": "sha256:30bbafd2552727f6af1766151ab1cbfb45fa54faf1d029b155bd7e4fd68605e8"
