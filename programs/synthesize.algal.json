    {
      "id": "sub",
      "kind": "expr",
      "inputs": {
        "d": "json",
        "ls": "json"
      },
      "expr": {
        "contract": "algal.expr.v1",
        "program": [
          "map",
          [
            "get",
            "d",
            "subsystems"
          ],
          "c",
          {
            "misfits": [
              "get",
              "c"
            ],
            "links": [
              "filter",
              [
                "get",
                "ls"
              ],
              "l",
              [
                "and",
                [
                  "contains",
                  [
                    "get",
                    "c"
                  ],
                  [
                    "get",
                    "l",
                    "a"
                  ]
                ],
                [
                  "contains",
                  [
                    "get",
                    "c"
                  ],
                  [
                    "get",
                    "l",
                    "b"
                  ]
                ]
              ]
            ]
          }
        ]
      },
      "output": {
        "kind": "json",
        "schema": {
          "type": "array"
        }
      }
    },
    {
      "id": "dg",
      "kind": "each",
      "manifest": "sha256:828404fa4dc6d9028da654dce90c0f5c400ede0add02352fbb23697ef307ab8f",
      "over": "forces",
      "maxItems": 16
    },
    {
      "id": "frags",
      "kind": "expr",
      "inputs": {
        "forms": "json"
      },
      "expr": {
        "contract": "algal.expr.v1",
        "program": [
          "map",
          [
            "filter",
            [
              "get",
              "forms"
            ],
            "f",
            [
              "isText",
              [
                "get",
                "f",
                "out"
              ]
            ]
          ],
          "f",
          [
            "get",
            "f",
            "out"
          ]
        ]
      },
      "output": {
        "kind": "json",
        "schema": {
          "type": "array"
        }
      }
    },
    {
